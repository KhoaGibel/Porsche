    Initial: <T, E = never>() => ReadResult<T, E>;
    Success: <T, E = never>(data: T) => ReadResult<T, E>;
    Failure: <T, E = never>(error: E) => ReadResult<T, E>;
};
/**
 * A read hook result that supports React Suspense
