  cost: Erc20AmountInput @deprecated(reason: "Use `erc20/native` instead")

  """The ERC 20 token amount. Mutually exclusive with `native`"""
  erc20: Erc20AmountInput

  """The native token amount. Mutually exclusive with `erc20`"""
  native: BigDecimal

  """The fee recipient."""
  recipient: EvmAddress!

  """
  The maximum percentage of the fee that can be allocated to referrals.
  This is calculated on the total amount after the treasury fee is deducted.
  """
  referralShare: Float! = 0
}

input SimplePaymentRuleProcessingParamsInput {
  """
  The list of referrers and their cut of the follow referral share.
  This is calculated as a percentage of the referral share AFTER the
  treasury fee is deducted.
  """
  referrals: [ReferralCut!]!
}

